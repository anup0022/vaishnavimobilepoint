# Copy to .env and fill in. .env is gitignored; this file is the template.

# REQUIRED in production. At least 32 characters, random.
# The admin session cookie is signed with this; anyone who knows it can sign in
# as the owner without a password. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SITE_URL=

# Number of reverse proxies in front of the app. Leave unset if exposed directly.
# TRUST_PROXY=1
