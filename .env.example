# Copy to .env and fill in. .env is gitignored; this file is the template.

# REQUIRED in production. At least 32 characters, random.
# The admin session cookie is signed with this; anyone who knows it can sign in
# as the owner without a password. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SITE_URL=

# Set on a host whose filesystem does not survive a restart (e.g. a Render free
# instance). Bookings, enquiries and reviews are written to SQLite and nowhere
# else, so rather than accept submissions that are about to be wiped, the API
# refuses them and the storefront offers WhatsApp and the phone number instead.
# Leave unset anywhere the data is actually kept.
# EPHEMERAL=true

# Number of reverse proxies in front of the app. Leave unset if exposed directly.
# TRUST_PROXY=1
